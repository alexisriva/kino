# ==============================================================================
# Kino Production Environment Variables
# VPS IP: 2.28.12.185
# ==============================================================================

# Domain / Hostname routed by Traefik (e.g. kino.example.com or your domain)
SERVER_HOST=kino.example.com

# Database Connection URL (SQLite persistent database inside container)
DATABASE_URL=file:/app/prisma/prod.db

# Admin Secret Key & JWT Secret (Generate strong secrets for production)
ADMIN_SECRET_KEY=change-this-to-a-secure-admin-key
JWT_SECRET=change-this-to-a-secure-jwt-secret-key-32-chars-min

# OMDb API Key for auto-filling movie/series posters, directors, cast, and plots
# Get a free key (1,000 req/day) at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key-here

# Node Environment
NODE_ENV=production
PORT=3000
